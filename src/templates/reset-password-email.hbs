<html lang='en'>

  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Reset password email</title>
  </head>

  <body>
    <div align='center' style='padding: 20px;'>

      <h1 style='color: #007bff;'>Hello, {{name}}!</h1>
      <p style='font-size: 16px; color: #333;'>You have requested to reset your
        password.</p>
      <p>
        <a
          href='{{link}}'
          style='display: inline-block; padding: 12px 24px; margin: 20px 0; background-color: #007bff; color: #ffffff; text-decoration: none; border-radius: 4px;'
        >Reset Password</a>
      </p>
      <p style='font-size: 14px; color: #999;'>If you didn't request this,
        please ignore this email.</p>

    </div>
  </body>
</html>