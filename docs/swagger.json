  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "User login",
        "operationId": "loginUser",
        "description": "login user with email and password",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "description": "User's email",
                    "type": "string",
                    "format": "email",
                    "example": "user@some.net"
                  },
                  "password": {
                    "description": "User's password",
                    "type": "string",
                    "example": "qwerty"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User login",
            "headers": {
              "Set-Cookie": {
                "description": "Cookies set after successful login",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "refreshToken=O250vTTCCs44EDFNo6kkcITmoQSX7oSv2Qm0lHt%2B; Path=/; Expires=Mon, 08 Sep 2025 12:55:47 GMT; HttpOnly",
                    "sessionId=j%3A%2268974553b7e801669e7b6d50%22; Path=/; Expires=Sat, 09 Aug 2025 13:10:47 GMT; HttpOnly"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "User successfully logged in"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "accessToken"
                      ],
                      "properties": {
                        "accessToken": {
                          "type": "string",
                          "example": "W+C9llkYIvlvYnTVbDZigh4v/1k0E3eLyEbhhz9H"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "User logout",
        "operationId": "logoutUser",
        "description": "Logout user. SessionId is used to delete the session. Also removes cookies from the client.",
        "security": [],
        "responses": {
          "204": {
            "description": "User successfully logged out",
            "headers": {
              "Set-Cookie": {
                "description": "Cookies cleared after successful logout.",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "refreshToken=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT; HttpOnly",
                    "sessionId=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT; HttpOnly"
                  ]
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "User session refresh",
        "operationId": "refreshUserSession",
        "description": "Refresh user session when session token is expired",
        "security": [],
        "responses": {
          "200": {
            "description": "User session refresh",
            "headers": {
              "Set-Cookie": {
                "description": "Cookies set after successful login",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "example": [
                  "refreshToken=O250vTTCCs44EDFNo6kkcITmoQSX7oSv2Qm0lHt%2B; Path=/; Expires=Mon, 08 Sep 2025 12:55:47 GMT; HttpOnly",
                  "sessionId=j%3A%2268974553b7e801669e7b6d50%22; Path=/; Expires=Sat, 09 Aug 2025 13:10:47 GMT; HttpOnly"
                ]
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully refreshed a session!"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "accessToken"
                      ],
                      "properties": {
                        "accessToken": {
                          "type": "string",
                          "example": "W+C9llkYIvlvYnTVbDZigh4v/1k0E3eLyEbhhz9H"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
